# =============================================================================
# School of Discipleship - Environment Variables
# =============================================================================
# Copy these to your Render/Railway deployment platform
# Separate services: Backend uses server variables, Frontend uses NEXT_PUBLIC_ variables
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Required - Both Services)
# -----------------------------------------------------------------------------
# Get from: https://supabase.com/dashboard/project/zlsijkmythaxtqrjocza/settings/api
SUPABASE_URL=https://zlsijkmythaxtqrjocza.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# BACKEND SERVICE - Copy these to backend deployment
# -----------------------------------------------------------------------------
APP_NAME=School of Discipleship API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["https://your-frontend-url.onrender.com"]

SECRET_KEY=generate-strong-32-char-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

PAYSTACK_SECRET_KEY=sk_live_xxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxx

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FRONTEND SERVICE - Copy these to frontend deployment (NEXT_PUBLIC_ only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://zlsijkmythaxtqrjocza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME=School of Discipleship
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true

# -----------------------------------------------------------------------------
# HOW TO USE
# -----------------------------------------------------------------------------
# 1. Get Supabase credentials from dashboard
# 2. Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Get Paystack keys from dashboard
# 4. Deploy backend first, note URL
# 5. Update NEXT_PUBLIC_API_URL with backend URL
# 6. Deploy frontend, note URL
# 7. Update BACKEND_CORS_ORIGINS with frontend URL
# =============================================================================
